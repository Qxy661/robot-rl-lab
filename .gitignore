# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---- 测试与检查 ----
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# ---- 训练产物 ----
# 训练输出、导出的模型、日志都不入库：它们体积大、可重新生成，
# 而且提交上去会让仓库随时间膨胀到不可用。要分享结果请提交 JSON 报告。
runs/
exported/
logs/
*.pt
*.pth
*.onnx
*.npz
events.out.tfevents.*

# ---- 机器人模型 ----
# Menagerie 由 scripts/fetch_assets.py 拉取，不随仓库分发（BSD-3 允许再分发，
# 但会让仓库变大且难以跟进上游更新）。
assets/menagerie/
third_party/

# ---- 编辑器与系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
